# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencias
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Pruebas y cobertura
coverage
test-results/
playwright-report/
blob-report/

# Next.js
.next/
out/

# Producción
build

# Varios
.DS_Store
Thumbs.db
*.pem

# Depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Variables de entorno (secretos locales; la plantilla .env.example sí se versiona)
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Herramientas
.eslintcache

# Claude Code / agentes de IA en el repo
# — .agents/skills: skills compartidas (Markdown, scripts); conviene versionarlas.
# — .claude/skills: suelen ser symlinks → .agents/skills para que Claude Code las detecte.
# — Ajustes de Claude en tu máquina (permisos, rutas absolutas; no subir):
.claude/settings.json
.claude/settings.local.json

# iOS nativa (apps/ios): el .xcodeproj lo genera XcodeGen desde project.yml
apps/ios/*.xcodeproj
apps/ios/DerivedData/
xcuserdata/
*.xcuserstate

# Android nativa (apps/android)
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/.idea/
apps/android/*.iml
apps/android/app/*.iml
apps/android/.kotlin/
